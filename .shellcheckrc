# board is many files sharing globals and sourcing each other by computed paths,
# so cross-file checks only produce noise here.
# SC2015: "[ a ] && [ b ] || fail" is used on purpose; the middle test cannot fail on its own.
# SC1010: done is a status category here, passed as an argument.
shell=sh
disable=SC1010,SC1090,SC1091,SC2015,SC2016,SC2034,SC2153,SC2154
