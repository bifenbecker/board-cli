#!/bin/sh
. "$(dirname -- "$0")/_fake.sh"
fake_log "glab $*"
if [ "${1:-}" = api ]; then
    shift
    fake_method=GET
    fake_path=
    fake_input=
    fake_query=
    while [ $# -gt 0 ]; do
        case $1 in
            -X | --method) fake_method=$2; shift 2 ;;
            --hostname | -H | --header | --output) shift 2 ;;
            --input) fake_input=1; shift 2 ;;
            -f | --raw-field) shift 2 ;;
            -F | --field)
                case $2 in
                    query=@-) fake_query=1 ;;
                esac
                shift 2
                ;;
            --paginate | -i | --include) shift ;;
            *) fake_path=$1; shift ;;
        esac
    done
    if [ "$fake_path" = graphql ]; then
        fake_body=$(fake_stdin)
        [ -n "$fake_query" ] || fake_body=$(printf '%s' "$fake_body" | jq -r .query)
        fake_reply glab "$(fake_operation "$fake_body")"
    fi
    [ -z "$fake_input" ] || fake_stdin >/dev/null
    fake_reply glab "$(fake_rest_key "$fake_method" "$fake_path")"
fi
fake_reply glab "$(fake_words "$@")"
