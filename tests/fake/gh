#!/bin/sh
. "$(dirname -- "$0")/_fake.sh"
fake_log "gh ${GH_HOST:+GH_HOST=$GH_HOST }$*"
if [ "${1:-}" = api ] && [ "${2:-}" = graphql ]; then
    fake_body=$(fake_stdin)
    fake_reply gh "$(fake_operation "$(printf '%s' "$fake_body" | jq -r .query)")"
fi
if [ "${1:-}" = api ]; then
    fake_method=GET
    fake_path=
    shift
    while [ $# -gt 0 ]; do
        case $1 in
            -X | --method) fake_method=$2; shift 2 ;;
            --input) fake_stdin >/dev/null; shift 2 ;;
            -H | -f | -F) shift 2 ;;
            --paginate | --slurp) shift ;;
            *) fake_path=$1; shift ;;
        esac
    done
    fake_reply gh "$(fake_rest_key "$fake_method" "$fake_path")"
fi
fake_reply gh "$(fake_words "$@")"
